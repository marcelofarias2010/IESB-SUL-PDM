{
  "info": {
    "name": "Gestão Financeira API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/",
        "description": "Verifica se a API está funcionando"
      }
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();",
                  "if (response.token) {",
                  "  pm.collectionVariables.set('token', response.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@admin.com\",\n  \"password\": \"123456\"\n}"
            }
          }
        },
        {
          "name": "Login - Email inválido",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"invalido\",\n  \"password\": \"123456\"\n}"
            }
          }
        },
        {
          "name": "Login - Senha errada",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@admin.com\",\n  \"password\": \"senhaerrada\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Categories",
      "item": [
        {
          "name": "Listar Categorias",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/categories"
          }
        },
        {
          "name": "Criar Categoria",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/categories",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"saude\",\n  \"displayName\": \"Saúde\",\n  \"icon\": \"heart\",\n  \"background\": \"#E91E63\",\n  \"isIncome\": false\n}"
            }
          }
        },
        {
          "name": "Criar Categoria - Dados inválidos",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/categories",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"\",\n  \"displayName\": \"\"\n}"
            }
          }
        },
        {
          "name": "Editar Categoria",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/categories/:id",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"displayName\": \"Saúde e Bem-estar\",\n  \"background\": \"#C2185B\"\n}"
            }
          }
        },
        {
          "name": "Excluir Categoria",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/categories/:id"
          }
        },
        {
          "name": "Excluir Categoria Padrão (deve falhar)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/categories/:id",
            "description": "Tente excluir uma categoria padrão. Deve retornar 400."
          }
        }
      ]
    },
    {
      "name": "Transactions",
      "item": [
        {
          "name": "Listar Transações",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/transactions"
          }
        },
        {
          "name": "Listar por mês e ano",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/transactions?month=6&year=2024",
              "query": [
                { "key": "month", "value": "6" },
                { "key": "year", "value": "2024" }
              ]
            }
          }
        },
        {
          "name": "Criar Transação",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/transactions",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"Salário\",\n  \"value\": 5000,\n  \"date\": \"2024-06-01T00:00:00.000Z\",\n  \"categoryId\": \"CATEGORY_ID_AQUI\"\n}"
            }
          }
        },
        {
          "name": "Criar Transação - Dados inválidos",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/transactions",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"\",\n  \"value\": -100\n}"
            }
          }
        },
        {
          "name": "Editar Transação",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/transactions/:id",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"Salário atualizado\",\n  \"value\": 5500\n}"
            }
          }
        },
        {
          "name": "Excluir Transação",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/transactions/:id"
          }
        }
      ]
    }
  ]
}
